<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lattice</AssemblyName>
    <RootNamespace>CSLibrary.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(MSBuildProjectDirectory)\..\build\Lattice.ico</ApplicationIcon>
    <Product>Lattice</Product>
    <Title>Lattice</Title>
    <Description>A shared knowledge library</Description>
    <Company>Lattice</Company>
    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>
  <Target Name="GenerateLatticeApplicationIcon" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\..\generate_icon.py&quot; --output &quot;$(ApplicationIcon)&quot;" />
  </Target>
</Project>
