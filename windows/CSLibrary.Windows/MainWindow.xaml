<Window x:Class="CSLibrary.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Lattice"
        Icon="{StaticResource LatticeIcon}"
        Width="1440"
        Height="920"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LatticeCanvasBrush}"
        FontFamily="{StaticResource LatticeSansFont}"
        Foreground="{StaticResource LatticeInkBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
  <Grid Background="{StaticResource LatticeCanvasBrush}">
    <wv2:WebView2 x:Name="Browser"
                  DefaultBackgroundColor="#F4F3EF"
                  AllowExternalDrop="True"
                  AutomationProperties.Name="Lattice library" />

    <ProgressBar x:Name="UpdateProgress"
                 Height="2"
                 Minimum="0"
                 Maximum="100"
                 VerticalAlignment="Top"
                 Panel.ZIndex="30"
                 Foreground="{StaticResource LatticeAccentBrush}"
                 Background="{StaticResource LatticeAccentSoftBrush}"
                 BorderThickness="0"
                 Visibility="Collapsed"
                 AutomationProperties.Name="Update progress" />

    <Border x:Name="LoadingOverlay"
            Panel.ZIndex="10"
            AutomationProperties.LiveSetting="Polite">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0" Color="#F8F7F4" />
          <GradientStop Offset="0.52" Color="#F4F3EF" />
          <GradientStop Offset="1" Color="#ECEEFB" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid Margin="28">
        <Border x:Name="LoadingCard"
                Width="560"
                MaxWidth="560"
                Padding="42,38,42,34"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F2FFFFFF"
                BorderBrush="{StaticResource LatticeLineBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Focusable="True"
                KeyboardNavigation.TabNavigation="Cycle"
                AutomationProperties.Name="Lattice status">
          <Border.Effect>
            <DropShadowEffect BlurRadius="44" ShadowDepth="14" Direction="270" Color="#2A191D28" Opacity="0.34" />
          </Border.Effect>
          <StackPanel>
            <Image Width="52" Height="52" HorizontalAlignment="Center" Source="{StaticResource LatticeIcon}" />
            <TextBlock x:Name="LoadingEyebrow"
                       Text="PRIVATE · LOCAL · SEARCHABLE"
                       Margin="0,22,0,0"
                       Foreground="{StaticResource LatticeAccentDeepBrush}"
                       FontSize="9.5"
                       FontWeight="Bold"
                       TextAlignment="Center" />
            <TextBlock x:Name="LoadingTitle"
                       Text="Opening your library…"
                       Margin="0,9,0,0"
                       Foreground="{StaticResource LatticeInkBrush}"
                       FontFamily="{StaticResource LatticeDisplayFont}"
                       FontSize="32"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="LoadingDetail"
                       Text="Starting the private local reading service"
                       Margin="0,13,0,0"
                       Foreground="{StaticResource LatticeMutedBrush}"
                       FontSize="13.5"
                       LineHeight="21"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="LoadingProgress"
                         Height="4"
                         Margin="48,25,48,0"
                         IsIndeterminate="True"
                         Foreground="{StaticResource LatticeAccentBrush}"
                         Background="{StaticResource LatticeAccentSoftBrush}"
                         BorderThickness="0" />
            <StackPanel x:Name="LoadingActions"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0">
              <Button x:Name="RetryButton"
                      Style="{StaticResource LatticePrimaryButtonStyle}"
                      Content="Try again"
                      Visibility="Collapsed"
                      Click="Retry_Click" />
              <Button x:Name="ChooseFolderButton"
                      Style="{StaticResource LatticeButtonStyle}"
                      Content="Choose another library…"
                      Margin="8,0,0,0"
                      Visibility="Collapsed"
                      Click="ChangeLibrary_Click" />
            </StackPanel>
            <WrapPanel Margin="0,28,0,0" HorizontalAlignment="Center">
              <TextBlock Foreground="{StaticResource LatticeMutedBrush}" FontSize="10.5" Text="●  Files stay local" />
              <TextBlock Margin="18,0,0,0" Foreground="{StaticResource LatticeMutedBrush}" FontSize="10.5" Text="●  Loopback only" />
              <TextBlock Margin="18,0,0,0" Foreground="{StaticResource LatticeMutedBrush}" FontSize="10.5" Text="●  No account required" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
