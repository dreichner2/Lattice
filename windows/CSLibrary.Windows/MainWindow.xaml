<Window x:Class="CSLibrary.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Lattice"
        Icon="{StaticResource LatticeIcon}"
        Width="1440"
        Height="920"
        MinWidth="900"
        MinHeight="620"
        Background="#0D0F14"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="#303643" BorderThickness="0,0,0,1">
      <DockPanel Margin="10,7">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button x:Name="BackButton" Content="←" Width="38" Padding="0" ToolTip="Back" AutomationProperties.Name="Back" IsEnabled="False" Click="Back_Click" />
          <Button x:Name="HomeButton" Content="⌂" Width="38" Padding="0" ToolTip="Library home" AutomationProperties.Name="Library home" IsEnabled="False" Click="Home_Click" />
          <Button x:Name="ReloadButton" Content="↻" Width="38" Padding="0" ToolTip="Reload" AutomationProperties.Name="Reload" IsEnabled="False" Click="Reload_Click" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="UpdateButton" Content="Checking for updates…" IsEnabled="False"
                  AutomationProperties.Name="Check for updates" Click="UpdateButton_Click" />
          <Button x:Name="AddMaterialsButton" Content="Add materials…" ToolTip="Add PDF, EPUB, or text materials"
                  AutomationProperties.Name="Add materials" IsEnabled="False" Click="AddMaterials_Click" />
          <Button Content="Open folder" Click="OpenFolder_Click" />
          <Button Content="Change library…" Margin="0" Click="ChangeLibrary_Click" />
        </StackPanel>
        <TextBlock Text="Lattice" Foreground="#F5F6F8" FontFamily="Georgia" FontSize="17"
                   FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
      </DockPanel>
    </Border>

    <wv2:WebView2 x:Name="Browser" Grid.Row="1" DefaultBackgroundColor="#0D0F14"
                  AllowExternalDrop="True" />

    <Border x:Name="LoadingOverlay" Grid.Row="1" Background="#0D0F14" Panel.ZIndex="5">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
        <TextBlock x:Name="LoadingTitle" Text="Opening your library…" Foreground="#F5F6F8"
                   FontFamily="Georgia" FontSize="30" TextAlignment="Center" />
        <TextBlock x:Name="LoadingDetail" Text="Starting the private local reading service"
                   Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" FontSize="14"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="ChooseFolderButton" Content="Choose another library…" HorizontalAlignment="Center"
                Margin="0,22,0,0" Visibility="Collapsed" Click="ChangeLibrary_Click" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#14171E" BorderBrush="#303643" BorderThickness="0,1,0,0">
      <DockPanel Margin="9,0">
        <TextBlock x:Name="StatusText" Text="Starting" Foreground="{StaticResource MutedBrush}"
                   FontSize="11" VerticalAlignment="Center" />
        <TextBlock x:Name="LibraryPathText" DockPanel.Dock="Right" Foreground="#777F90"
                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
